# 复制为 .env 后填写。所有密钥请用 openssl rand -base64 48 生成，不要提交。
HEDGEDOC_DOMAIN=https://docs.jmi-openatom.cn
HEDGEDOC_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
HEDGEDOC_DB_PASS=CHANGE_ME_DB_PASS

# 主站 OIDC 客户端（在管理端「OAuth 客户端管理」中注册）
# clientId=openatom-hedgedoc，redirect_uri=https://docs.jmi-openatom.cn/auth/oauth2/callback
# scopes=openid profile email，grantTypes=authorization_code refresh_token
OAUTH2_CLIENT_ID=openatom-hedgedoc
OAUTH2_CLIENT_SECRET=CHANGE_ME_OAUTH_CLIENT_SECRET

# ONLYOFFICE（--profile office 时需要）
DOCUMENT_SERVER_JWT_SECRET=CHANGE_ME_DOCUMENT_SERVER_JWT_SECRET
DOCUMENT_SERVER_DB_PASS=CHANGE_ME_DOCUMENT_SERVER_DB_PASS

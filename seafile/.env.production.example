# Runtime images
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0.25
SEAFILE_DB_IMAGE=mariadb:10.11
SEAFILE_REDIS_IMAGE=redis:7-alpine

# Persistent host paths. Keep data and backups outside container layers.
SEAFILE_VOLUME=/www/wwwroot/openatom-seafile/data
SEAFILE_MYSQL_VOLUME=/www/wwwroot/openatom-seafile/mysql
SEAFILE_BACKUP_VOLUME=/www/backup/openatom-seafile

# Generated once by GitHub Actions on the production server.
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATED_ON_SERVER
SEAFILE_MYSQL_DB_USER=seafile
SEAFILE_MYSQL_DB_PASSWORD=CHANGE_ME_GENERATED_ON_SERVER
REDIS_PASSWORD=CHANGE_ME_GENERATED_ON_SERVER
JWT_PRIVATE_KEY=CHANGE_ME_GENERATED_ON_SERVER_AT_LEAST_32_CHARACTERS
INIT_SEAFILE_ADMIN_EMAIL=admin@jmi-openatom.cn
INIT_SEAFILE_ADMIN_PASSWORD=CHANGE_ME_GENERATED_ON_SERVER

# Public endpoint and loopback-only upstream
SEAFILE_SERVER_HOSTNAME=cloud.jmi-openatom.cn
SEAFILE_BIND_ADDRESS=127.0.0.1
SEAFILE_HTTP_PORT=18083
TIME_ZONE=Asia/Shanghai
NON_ROOT=false
ENABLE_SEAFDAV=false

# Existing OpenAtom OAuth provider
SEAFILE_OAUTH_CLIENT_ID=openatom-seafile
SEAFILE_OAUTH_CLIENT_SECRET=CHANGE_ME_SHARED_WITH_OPENATOM_BACKEND
# Keep local login for the emergency Seafile admin. Set true only after promoting an OAuth user to admin.
SEAFILE_DISABLE_PASSWORD_LOGIN=false

# Daily backup: one run at container startup, then every 24 hours.
SEAFILE_BACKUP_INTERVAL_SECONDS=86400
SEAFILE_BACKUP_RETENTION_DAYS=14

# Nginx/Let's Encrypt
SEAFILE_ACME_EMAIL=postmaster@jmi-openatom.cn
NGINX_CONF_DIR=/www/server/panel/vhost/nginx

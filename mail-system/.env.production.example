# OpenAtom Mail production environment
# Copy to a protected path outside Git. Never commit the populated file.

# Required: independent mail control-plane MySQL
MAIL_DB_PASSWORD=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
MAIL_DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_32_PLUS_RANDOM_CHARACTERS

# Required: server-side OAuth session store
MAIL_REDIS_PASSWORD=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# Required: permanent address collision salt. Never rotate after first mailbox creation.
MAIL_ADDRESS_SALT=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# Required: must equal APP_MAIL_SERVICE_TOKEN on the main site.
MAIL_INTERNAL_SERVICE_TOKEN=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# Required: secret of the confidential OAuth client openatom-mail-web.
MAIL_OAUTH_CLIENT_SECRET=CHANGE_ME_FROM_OPENATOM_OAUTH_CLIENT

# Required for outbound delivery: Resend API key (re_...). Resend relays
# outbound mail on the verified domain mailer.jmi-openatom.cn; without it the
# web client cannot send mail.
MAIL_RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY

# 群发邮件收件人来源：主站内部接口（默认公网地址，可覆盖）
MAIN_SITE_INTERNAL_USERS_URL=https://api.jmi-openatom.cn/api/v1/internal/mail/users
# 群发邮件的发件地址（必须在 Resend 已验证域名上）
MAIL_BROADCAST_FROM=no-reply@mailer.jmi-openatom.cn

# Server-managed: deploy.sh generates the two least-privilege API keys and resolves
# the domain ID during first bootstrap. Leave blank; never copy them to GitHub.
STALWART_CONFIG_TOKEN=
STALWART_API_TOKEN=
STALWART_DOMAIN_ID=

# Server-managed: Resend SMTP relay credentials used by Alertmanager for alert
# delivery (host smtp.resend.com:465). Leave blank; deploy.sh fills them from
# MAIL_RESEND_API_KEY.
MAIL_RESEND_SMTP_USERNAME=
MAIL_RESEND_SMTP_PASSWORD=

# Alertmanager alert recipient. Use a real mailbox that can receive mail
# (Resend cannot deliver to addresses on the sending-only verified domain unless
# an inbound webhook route exists; a personal or ops mailbox is a safe default).
MAIL_ALERT_RECIPIENT=CHANGE_ME_OPS_MAILBOX

# Server-managed bootstrap/recovery credential. Auto mode generates and clears it.
STALWART_RECOVERY_ADMIN=
STALWART_RECOVERY_MODE=0
STALWART_AUTOMATION_ACCOUNT=openatom-automation

# Public identity
MAIL_DOMAIN=jmi-openatom.cn
MAIL_HOSTNAME=mx1.jmi-openatom.cn
MAIL_ACME_EMAIL=postmaster@jmi-openatom.cn
STALWART_PUBLIC_URL=https://mail.jmi-openatom.cn
MAIL_DEFAULT_QUOTA_BYTES=2147483648
MAIL_MAX_MESSAGE_BYTES=26214400

# OAuth/OIDC endpoints
MAIL_OAUTH_ISSUER=https://oauth.jmi-openatom.cn/api/v1
MAIL_OAUTH_AUDIENCE=stalwart
MAIL_OAUTH_AUTHORIZATION_URL=https://oauth.jmi-openatom.cn/api/v1/oauth/authorize
MAIL_OAUTH_TOKEN_URL=https://oauth.jmi-openatom.cn/api/v1/oauth/token
MAIL_OAUTH_JWKS_URL=https://oauth.jmi-openatom.cn/api/v1/oauth/jwks
MAIL_OAUTH_CLIENT_ID=openatom-mail-web
MAIL_OAUTH_REDIRECT_URI=https://mail.jmi-openatom.cn/api/oauth/callback

# Loopback-only host bindings; change only when another local service already uses them.
MAIL_API_INTERNAL_PORT=18090
MAIL_WEB_INTERNAL_PORT=18082
STALWART_SETUP_PORT=18081
MAIL_PROMETHEUS_INTERNAL_PORT=19090
MAIL_ALERTMANAGER_INTERNAL_PORT=19093
MAIL_NODE_EXPORTER_INTERNAL_PORT=19100
MAIL_BLACKBOX_INTERNAL_PORT=19115

# Advanced deployment defaults. Pin STALWART_CLI_IMAGE to an immutable digest in
# production after the initial validation if your supply-chain policy requires it.
STALWART_CLI_IMAGE=ghcr.io/stalwartlabs/cli:latest
STALWART_DOCKER_NETWORK=openatom-mail_mail-internal
STALWART_TLS_HOST_DIR=./.runtime/stalwart-tls
NGINX_CONF_DIR=/etc/nginx/conf.d

# Required only when enabling encrypted scheduled backups. This is the public age
# recipient; keep the matching private identity offline and outside this env file.
MAIL_BACKUP_AGE_RECIPIENT=age1CHANGE_ME

# Main-site variables belong to the main repository .env, not the mail Compose env:
# APP_OIDC_ISSUER=https://oauth.jmi-openatom.cn/api/v1
# APP_OIDC_RESOURCE_AUDIENCE=stalwart
# APP_OIDC_KEY_ID=openatom-oidc-rs256
# APP_OIDC_PRIVATE_KEY_BASE64=CHANGE_ME_PKCS8_DER_BASE64
# APP_OIDC_PUBLIC_KEY_BASE64=CHANGE_ME_X509_DER_BASE64
# APP_OIDC_PREVIOUS_KEY_ID=
# APP_OIDC_PREVIOUS_PUBLIC_KEY_BASE64=
# APP_MAIL_PROVISION_URL=http://127.0.0.1:18090/internal/v1/mailboxes/provision
# APP_MAIL_SERVICE_TOKEN=SAME_AS_MAIL_INTERNAL_SERVICE_TOKEN
# APP_MAIL_OUTBOX_BATCH_SIZE=50
# APP_MAIL_OUTBOX_MAX_RETRIES=12
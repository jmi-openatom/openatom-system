; Replace 203.0.113.10 and DKIM_PUBLIC_KEY before publishing.
; Do not publish AAAA until IPv6 inbound and outbound delivery has been tested.
mailer                 3600 IN MX 10 mx1.jmi-openatom.cn.
mx1                    3600 IN A 203.0.113.10
mail                    3600 IN A 203.0.113.10
mta-sts                 3600 IN A 203.0.113.10
; Preserve the existing Resend SPF, DKIM and Return-Path records for mailer.
stalwart._domainkey.mailer 3600 IN TXT "v=DKIM1; k=rsa; p=DKIM_PUBLIC_KEY"
_dmarc.mailer          3600 IN TXT "v=DMARC1; p=quarantine; rua=mailto:dmarc@mailer.jmi-openatom.cn; adkim=s; aspf=s; pct=100"
; Publish _mta-sts.mailer only after mta-sts.mailer has HTTPS and a policy.
; TLS reporting requires a working report mailbox before publication.

